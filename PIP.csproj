<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Library</OutputType>
    <RootNamespace>PIP</RootNamespace>
    <AssemblyName>PhilsIterativeParts</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <KspDir>C:\Program Files (x86)\Steam\steamapps\common\Kerbal Space Program</KspDir>
    <KspManaged>$(KspDir)\KSP_x64_Data\Managed</KspManaged>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="Assembly-CSharp"><HintPath>$(KspManaged)\Assembly-CSharp.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(KspManaged)\UnityEngine.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(KspManaged)\UnityEngine.AnimationModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(KspManaged)\UnityEngine.CoreModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(KspManaged)\UnityEngine.IMGUIModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(KspManaged)\UnityEngine.PhysicsModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(KspManaged)\UnityEngine.InputLegacyModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(KspManaged)\UnityEngine.TextRenderingModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(KspDir)\GameData\000_Harmony\0Harmony.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Core\Model.cs" />
    <Compile Include="Core\Progress.cs" />
    <Compile Include="Core\PartType.cs" />
    <Compile Include="Core\Fuels.cs" />
    <Compile Include="Core\LiquidEngines.cs" />
    <Compile Include="Core\OtherEngines.cs" />
    <Compile Include="Core\Parts.cs" />
    <Compile Include="Core\Program.cs" />
    <Compile Include="Core\Names.cs" />
    <Compile Include="KSP\Settings.cs" />
    <Compile Include="KSP\TechUnlocks.cs" />
    <Compile Include="KSP\PartFactory.cs" />
    <Compile Include="KSP\Looks.cs" />
    <Compile Include="KSP\HarmonyPatches.cs" />
    <Compile Include="KSP\PipScenario.cs" />
    <Compile Include="KSP\ModulePipEngine.cs" />
    <Compile Include="KSP\ModulePipPart.cs" />
    <Compile Include="KSP\FlightTracker.cs" />
    <Compile Include="KSP\EditorHider.cs" />
    <Compile Include="KSP\Requirements.cs" />
    <Compile Include="KSP\PipSkin.cs" />
    <Compile Include="KSP\PartPreview.cs" />
    <Compile Include="KSP\PipWindow.cs" />
    <Compile Include="KSP\Comparison.cs" />
    <Compile Include="KSP\PartInfo.cs" />
    <Compile Include="KSP\FuelLoader.cs" />
    <Compile Include="KSP\ModulePipBoiloff.cs" />
  </ItemGroup>
  <ItemGroup>
    <GameDataFiles Include="GameData\**\*.*" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- Install into the game after a successful build: the DLL plus everything under GameData\. -->
  <!-- Build with /p:NoInstall=true to build without touching the game. -->
  <Target Name="InstallToGame" AfterTargets="Build" Condition="'$(NoInstall)' != 'true'">
    <Copy SourceFiles="$(OutputPath)PhilsIterativeParts.dll" DestinationFolder="$(KspDir)\GameData\PIP\Plugins" />
    <Copy SourceFiles="@(GameDataFiles)" DestinationFiles="@(GameDataFiles->'$(KspDir)\GameData\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
